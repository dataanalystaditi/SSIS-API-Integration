          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Windows.Forms;
using System.IO;
using System.Net.Http;
using System.Text;

namespace ST_YourScriptNamespaceHere
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPoint]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private void SafeLog(string filePath, string message)
        {
            for (int retry = 0; retry < 3; retry++)
            {
                try
                {
                    using (StreamWriter writer = new StreamWriter(filePath, true, Encoding.UTF8))
                    {
                        writer.WriteLine($"[{DateTime.Now}] {message}");
                        break;
                    }
                }
                catch (IOException)
                {
                    System.Threading.Thread.Sleep(100);
                }
            }
        }

        public void Main()
        {
            try
            {
                string apiUrl = Dts.Variables["User::API_URL"].Value?.ToString() ?? "";
                string sourceFile = Dts.Variables["User::SourceExcelPath"].Value?.ToString();
                string logFilePath = Dts.Variables["User::LogFilePath"].Value?.ToString();

                int recordsLoaded = Convert.ToInt32(Dts.Variables["User::RecordsLoaded"].Value);
                int invalidRows = Convert.ToInt32(Dts.Variables["User::InvalidRows"].Value);

                string payload = "{\"customerId\":999, \"name\":\"Demo Customer\", \"email\":\"demo@example.com\"}";
                string apiStatus = "NotStarted";

                SafeLog(logFilePath, "=== Script STARTED ===");
                SafeLog(logFilePath, $"API URL: {apiUrl}");
                SafeLog(logFilePath, $"Payload: {payload}");

                using (HttpClient client = new HttpClient())
                {
                    var content = new StringContent(payload, Encoding.UTF8, "application/json");
                    var response = client.PostAsync(apiUrl, content).GetAwaiter().GetResult();

                    if (response.IsSuccessStatusCode)
                    {
                        apiStatus = "Successful";
                        SafeLog(logFilePath, "API Call SUCCESSFUL");
                    }
                    else
                    {
                        apiStatus = "Failed";
                        SafeLog(logFilePath, $"API Call FAILED. Status: {response.StatusCode}");
                    }
                }

                Dts.Variables["User::ApiCallStatus"].Value = apiStatus;

                SafeLog(logFilePath, $"Records Loaded: {recordsLoaded}");
                SafeLog(logFilePath, $"Invalid Rows: {invalidRows}");
                SafeLog(logFilePath, $"API Call Status: {apiStatus}");
                SafeLog(logFilePath, "=== Script COMPLETED ===");

                System.Windows.Forms.MessageBox.Show
                (
                    $"SSIS Package executed successfully!\n" +
                    $"Records Loaded: {recordsLoaded}\n" +
                    $"Invalid Rows: {invalidRows}\n" +
                    $"API Call: {apiStatus}",
                    "Execution Status"
                );

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                string fallback = "C:\\Temp\\final_script_error.txt";
                SafeLog(fallback, $"ERROR: {ex.Message}\n{ex.StackTrace}");
                Dts.Events.FireError(0, "Script Task Failure", ex.Message + "\n" + ex.StackTrace, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        }
    }
}]]></ProjectItem>
